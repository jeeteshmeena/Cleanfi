[Unit]
Description=Cleanfi Telegram Metadata Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Cleanfi
EnvironmentFile=/home/ubuntu/Cleanfi/.env
ExecStart=/home/ubuntu/Cleanfi/.venv/bin/python /home/ubuntu/Cleanfi/bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
